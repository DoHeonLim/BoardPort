{
  "name": "boardport",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:e2e": "next dev --webpack -H 127.0.0.1",
